public class Question5FOR
{
    public static void main(String args[])
    {
        int i=1;
        Node head=null;
        Node prev=null;
        while(i<=10)
        {
            Node node= new Node();
            node.val=i;
            if(prev==null)
            {
                head=node;
            }
            else
            {
                prev.next=node;
            }
            prev=node;
            i++;
        }
        Node newNode = new Node();
        newNode.val = 67;
        //prev = head;
        //while (prev.next != null) {
           // prev = prev.next;
        //}
        prev.next = newNode;
        prev = head;
        while(prev!=null)
        {
            System.out.println(prev.val);
           prev=prev.next;
        }
    }
}
