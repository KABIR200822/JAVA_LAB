public class Question4FOR
{
    public static void main(String args[])
    {
        int i=1;
        Node head=null;
        Node prev=null;
        while(i<=10)
        {
            Node node= new Node();
            node.val=i;
            if(prev==null)
            {
                head=node;
            }
            else
            {
                prev.next=node;
            }
            prev=node;
            i++;
        }
        Node newNode = new Node();
        newNode.val = 67;
        newNode.next=head;
        head=newNode;
        prev=head;
        while(prev!=null)
        {
            System.out.println(prev.val);
            prev=prev.next;
        }
}
  
